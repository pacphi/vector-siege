{
  "name": "vector-siege",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/package-sites.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:sites": "node tests/sites-adapter.test.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run test:sites"
  },
  "dependencies": {
    "three": "^0.179.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/three": "^0.179.0",
    "typescript": "^7.0.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
